// User-owned binds loaded after the auto-generated DMS binds.

recent-windows {
    binds {
        Alt+Tab {
            next-window scope="workspace";
        }
        Alt+Shift+Tab {
            previous-window scope="workspace";
        }
    }
}

binds {
    Mod+Space hotkey-overlay-title="Application Launcher" {
        spawn "dms" "ipc" "call" "spotlight" "toggle";
    }
    Mod+S repeat=false hotkey-overlay-title="Workspace 11" {
        focus-workspace 11;
    }
    Mod+Shift+S repeat=false hotkey-overlay-title="Move Window to Workspace 11" {
        move-window-to-workspace 11;
    }
    Mod+Tab repeat=false hotkey-overlay-title="Focus Next Monitor" {
        focus-monitor-next;
    }
    Mod+Shift+Tab repeat=false hotkey-overlay-title="Move Window to Next Monitor" {
        move-window-to-monitor-next;
    }
}
